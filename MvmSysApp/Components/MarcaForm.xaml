<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MvmSysApp.Components.MarcaForm">
    <VerticalStackLayout Spacing="10">
        <Label Text="Nome da marca" />
        <Entry x:Name="entNome" Placeholder="Ex.: Toyota" MaxLength="50" />

        <Label Text="País de origem" />
        <!-- Picker: lista suspensa (as opções são definidas no code-behind) -->
        <Picker x:Name="pkPais" Title="Selecione o país" />

        <!-- Switch: chave liga/desliga -->
        <HorizontalStackLayout Spacing="10">
            <Switch x:Name="swAtiva"
                    IsToggled="True"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Marca ativa" />
            <Label Text="Marca ativa" VerticalOptions="Center" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>
